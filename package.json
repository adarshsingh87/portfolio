{
  "name": "adarsh-portfolio",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "generate:seo": "node scripts/generate-seo.mjs",
    "generate:previews": "node scripts/generate-og.mjs && node scripts/generate-blog-previews.mjs",
    "generate:contributions": "node scripts/fetch-contributions.mjs",
    "build": "node scripts/generate-seo.mjs && node scripts/generate-og.mjs && node scripts/generate-blog-previews.mjs && vite build",
    "preview": "vite preview",
    "lint": "eslint",
    "format": "prettier --write . && eslint --fix",
    "check": "prettier --check .",
    "deploy": "pnpm build && wrangler deploy"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@tanstack/react-router": "latest",
    "@tanstack/react-start": "latest",
    "marked": "^16.4.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "shiki": "^4.5.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.26.0",
    "@tanstack/eslint-config": "latest",
    "@tanstack/router-cli": "^1.132.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.20.0",
    "prettier": "^3.8.1",
    "sharp": "^0.35.4",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "wrangler": "^4.70.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss",
      "sharp",
      "workerd"
    ]
  }
}
